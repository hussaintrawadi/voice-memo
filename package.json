{
  "name": "voice-memo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ENV=dev vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "icons": "pwa-assets-generator",
    "android:build": "scripts/android-build.sh",
    "pretypecheck": "wrangler types"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "agents": "^0.24.0",
    "dexie": "^4.4.6",
    "hono": "^4.13.8",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/vite-plugin": "^1.54.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.133.0"
  },
  "license": "MIT",
  "description": "Voice-first second brain on Cloudflare free tiers: record, transcribe, organise, search, and ask Claude."
